# Neon Postgres pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# DSPy models via OpenRouter
RLM_ROOT_MODEL=openrouter/openai/gpt-4o
RLM_SUB_MODEL=openrouter/openai/gpt-4o-mini

# Embedding model (must match vector(dimension) in SQL)
EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small
EMBEDDING_DIM=1536

# OpenRouter API key
OPENROUTER_API_KEY=sk-or-...

# Bearer token for API auth
API_SECRET_KEY=change-me

# Worker pool
DB_POOL_SIZE=10
