# Neon Postgres pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Required model IDs. Replace placeholders with currently verified IDs supported
# by your DSPy/LiteLLM provider; the service does not hard-code a model catalog.
RLM_ROOT_MODEL=REPLACE_WITH_VERIFIED_PROVIDER_ROOT_MODEL_ID
RLM_SUB_MODEL=REPLACE_WITH_VERIFIED_PROVIDER_SUB_MODEL_ID

# Must produce exactly EMBEDDING_DIM floats and match vector(N) in migrations 001/002.
EMBEDDING_MODEL=REPLACE_WITH_VERIFIED_PROVIDER_EMBEDDING_MODEL_ID
EMBEDDING_DIM=1536

# Provider credentials consumed by DSPy/LiteLLM (example when using OpenRouter).
OPENROUTER_API_KEY=REPLACE_WITH_PROVIDER_SECRET

# Opaque bearer keys mapped to tenants. Values may instead be objects containing
# tenant_id, optional subject_id, and optional role.
API_KEYS_JSON='{"REPLACE_WITH_LONG_RANDOM_KEY":{"tenant_id":"tenant-example"}}'

# Database and worker tuning
DB_POOL_SIZE=10
WORKER_POLL_SECONDS=1
WORKER_STALE_SECONDS=600
WORKER_BATCH_SIZE=1
# Exit after this many consecutive queue/outbox poll failures.
WORKER_MAX_POLL_FAILURES=5

# false: run `python worker.py` separately (recommended for production).
# true: API also starts a managed worker (single-container convenience).
EMBEDDED_WORKER=false
